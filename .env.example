# Copy to .env and fill in. Loaded by config/settings.py at startup.

# Active Directory login (brembana-auth). Ask IT for the service account
# password and, in production, for the internal CA certificate.
BREMBANA_LDAP_URI=ldaps://BRBGDOM.brembana.dom:636
BREMBANA_LDAP_BASE_DN=DC=brembana,DC=dom
BREMBANA_LDAP_BIND_USER=svc-brembana-auth@brembana.dom
BREMBANA_LDAP_BIND_PASSWORD=
# Required in production: without it the DC certificate is not verified.
# BREMBANA_LDAP_CA_CERT=C:\certs\brembana-ca.pem
# BREMBANA_LDAP_TIMEOUT=5
